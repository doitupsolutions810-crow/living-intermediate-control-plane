{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:doitupsolutions810-crow:control-plane:evidence-envelope:v1",
  "title": "Cross-Repository Evidence Envelope v1",
  "description": "Proposed envelope contract. Signature verification, issuer authorization, freshness, replay checks, and subject matching must be enforced by code; JSON Schema alone is insufficient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "evidence_type",
    "claim",
    "subject",
    "execution",
    "authority",
    "policy",
    "issued_at",
    "expires_at",
    "request_id",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "control-plane.evidence-envelope/v1"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_type": {
      "enum": [
        "execution",
        "test",
        "build",
        "supply_chain",
        "policy"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "DEGRADED",
            "FAIL",
            "NOT_RUN",
            "NOT_VERIFIED"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "artifact_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "workflow_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "mode": {
          "enum": [
            "real",
            "simulation",
            "static_analysis",
            "not_applicable"
          ]
        },
        "worker_receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "issuer",
        "key_id"
      ],
      "properties": {
        "class": {
          "enum": [
            "public",
            "local",
            "signed_internal"
          ]
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "real"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "type": "object",
            "required": [
              "worker_receipt_id"
            ],
            "properties": {
              "worker_receipt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "simulation"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "claim": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "DEGRADED",
                  "FAIL",
                  "NOT_RUN",
                  "NOT_VERIFIED"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        }
      }
    }
  ]
}
