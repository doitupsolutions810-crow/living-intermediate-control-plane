{
  "name": "living-intermediate-control-plane",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Unified lattice · Avrone Due’Krey · LaunchDesk · Control704 high-priority surface",
  "scripts": {
    "init": "node status/init.mjs",
    "check": "node integrate.mjs",
    "procure": "ACCEPT_LOCAL_EVIDENCE=1 node integrate.mjs procure",
    "procure:gated": "GATE_DOCTOR=1 ACCEPT_LOCAL_EVIDENCE=1 node integrate.mjs procure",
    "dry-run": "DRY_RUN=1 ACCEPT_LOCAL_EVIDENCE=1 node integrate.mjs procure",
    "status": "node status/plane-status.mjs",
    "readiness": "node lattice/readiness-poller.mjs",
    "log": "node status/decision-log.mjs",
    "last": "node status/last.mjs",
    "export": "node status/export-decisions.mjs",
    "actions": "node launchdesk/actions.mjs list",
    "pause": "node integrate.mjs pause",
    "resume": "node integrate.mjs resume",
    "state": "node status/plane-state.mjs",
    "continuous": "node status/continuous-readiness.mjs",
    "watch": "node status/watch.mjs",
    "snapshot": "node status/snapshot.mjs",
    "next": "node status/next.mjs",
    "health": "node status/health.mjs",
    "doctor": "node status/doctor.mjs",
    "info": "node status/info.mjs",
    "security-summary": "node status/security-summary.mjs",
    "report": "node status/report.mjs",
    "report:write": "node status/report.mjs --write",
    "help": "node status/help.mjs",
    "smoke": "node status/smoke.mjs",
    "ci": "node status/ci-check.mjs",
    "docker:build": "docker build -t living-intermediate-control-plane:0.4.1 .",
    "docker:doctor": "docker run --rm living-intermediate-control-plane:0.4.1",
    "reset-local": "node status/reset-local.mjs",
    "test": "node test/self-test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
