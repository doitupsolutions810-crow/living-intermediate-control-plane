{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/doitupsolutions810-crow/living-intermediate-control-plane/blob/main/contracts/production-acceptance/v1.schema.json",
  "title": "Great Scale Proof-Carrying Production Acceptance Attestation v1",
  "description": "G0-G6 production acceptance proof bound to exact source revision, executed workflow, required suite outcomes, immutable artifact digest, and per-gate evidence. E0-E6 procurement evidence is not a substitute.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "issuer",
    "keyId",
    "environment",
    "buildId",
    "generatedAt",
    "expiresAt",
    "source",
    "execution",
    "artifact",
    "suiteResults",
    "gates",
    "residual",
    "digest",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "great-scale.production-acceptance/v1"
    },
    "issuer": {
      "const": "living-intermediate-control-plane-production-acceptance"
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "const": "production"
    },
    "buildId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commitSha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "runAttempt",
        "runUrl",
        "headSha",
        "conclusion",
        "completedAt"
      ],
      "properties": {
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "runUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\\\.com/"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "conclusion": {
          "const": "success"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "suiteResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "conclusion",
          "headSha",
          "runId",
          "runAttempt",
          "evidenceUrl",
          "evidenceDigest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "conclusion": {
            "const": "success"
          },
          "headSha": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "runId": {
            "type": "integer",
            "minimum": 1
          },
          "runAttempt": {
            "type": "integer",
            "minimum": 1
          },
          "evidenceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\\\.com/"
          },
          "evidenceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "G0",
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6"
            ]
          },
          "status": {
            "const": "PASS"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "suiteName",
                "evidenceDigest",
                "observedAt"
              ],
              "properties": {
                "suiteName": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "G0"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "G1"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "G2"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "G3"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "G4"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "G5"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "G6"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sourceId",
        "buildId",
        "measuredAt",
        "S"
      ],
      "properties": {
        "schema": {
          "const": "great-scale.residual-attestation/v1"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "buildId": {
          "type": "string",
          "minLength": 1
        },
        "measuredAt": {
          "type": "string",
          "format": "date-time"
        },
        "S": {
          "type": "number"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
