[Unit]
Description=Living Intermediate Control Plane unattended self-develop loop
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/living-intermediate-control-plane
ExecStart=/usr/bin/node status/unattended.mjs
Environment=ALLOW_SKIP=1
# Environment=UNATTENDED_CONTINUE_ON_FAIL=1
Nice=10
TimeoutStartSec=45min

[Install]
WantedBy=default.target
