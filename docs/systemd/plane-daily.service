[Unit]
Description=Living Intermediate Control Plane daily operator loop
Documentation=file:docs/operator-host-setup.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Clone path — %h is home for user units
WorkingDirectory=%h/living-intermediate-control-plane
# Prefer absolute node path on production hosts
ExecStart=/usr/bin/node status/daily-loop.mjs
# Examples:
# ExecStart=%h/.nvm/versions/node/v20.11.0/bin/node status/daily-loop.mjs
# ExecStart=/usr/bin/npm run daily
# Environment=DAILY_GATE_DOCTOR=1
# Environment=DAILY_CONTINUE_ON_FAIL=1
# Environment=DAILY_SIGN=1
# Environment=IMAGE_REF=living-intermediate-control-plane:0.5.3
Nice=10
TimeoutStartSec=30min

[Install]
WantedBy=default.target
