# Platform control plane (server-side only — never commit real secrets)
CONTROL12_PLATFORM_URL=http://127.0.0.1:8787
CONTROL12_PLATFORM_TOKEN=

# Optional: public evidence-console base URL (v5.3.1 contract).
# When unset or returning 404, cockpit/integrate fall back to local plane authority.
EVIDENCE_CONSOLE_URL=

# --- Agent / LLM (Grok-class tool loop + free/OSS fallbacks) ---
# Default order:
#   openai → xai → grok → openrouter (each free model) → groq (+ gpt-oss-20b) →
#   mistral → gemini → nvidia → cerebras → huggingface → compatible → pollinations
# On HTTP 401/402/403/429 (or billing/credit/quota body), runtime retries the next config.
# Optional: AVRONE_LLM_PREFER=<provider> to put that provider first when it matches.
# AVRONE_LLM_PREFER=openai

# Paid / primary (tried first when keys present)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-2-latest

GROK_API_KEY=
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-2-latest

# --- Free / open-source fallbacks (activate only when key or flag present) ---

# OpenRouter free models — expands OPENROUTER_FREE_MODELS into separate tries
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated; each becomes its own LlmConfig entry
# OPENROUTER_FREE_MODELS=openrouter/free,qwen/qwen3.8-27b:free,nex-agi/nex-n2.5-pro:free,inclusionai/ling-3.0-flash-vl:free

# Groq (OSS models) — primary + automatic second try openai/gpt-oss-20b
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b

# Mistral
MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-small-latest

# Google Gemini (OpenAI-compatible path)
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Cerebras
CEREBRAS_API_KEY=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODEL=llama3.1-8b

# Hugging Face Inference Router (HF_TOKEN or HUGGINGFACE_API_KEY)
HF_TOKEN=
# HUGGINGFACE_API_KEY=
# HF_BASE_URL=https://router.huggingface.co/v1
# HF_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Self-hosted OpenAI-compatible (Ollama / vLLM / LocalAI)
# AVRONE_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# AVRONE_COMPATIBLE_API_KEY=
# AVRONE_COMPATIBLE_MODEL=llama3.1

# Pollinations keyless OpenAI-compatible chat (enabled unless set to 0)
# No API key required. Model openai-fast routes to gpt-oss-class OSS.
AVRONE_POLLINATIONS_ENABLED=1
# AVRONE_POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
# AVRONE_POLLINATIONS_MODEL=openai-fast

# Optional web_search via Tavily (https://api.tavily.com/search)
TAVILY_API_KEY=

# Shell sandbox (OFF by default on Vercel / serverless)
# Set to 1 only on trusted hosts where allowlisted shell is acceptable.
AVRONE_SHELL_ENABLED=0
# Optional sandbox working directory (defaults to <cwd>/.avrone-sandbox)
AVRONE_SANDBOX_DIR=

# Next.js
# PORT=3000

# --- LangGraph agent + operator training (prompt-memory) ---
# LangGraph StateGraph path (default ON when unset/empty). Set 0/false/off to use classic agent-loop only.
# AVRONE_LANGGRAPH_ENABLED=1
#
# Operator lessons (prompt-memory training — NOT model weight fine-tuning).
# Optional durable JSON array blob (best for Vercel cold starts):
# AVRONE_OPERATOR_MEMORY=["Prefer OpenRouter when paid credits are empty","Keep answers concise"]
# Optional writable path (defaults to /tmp/avrone-operator-memory.json; best-effort on serverless):
# AVRONE_OPERATOR_MEMORY_PATH=/tmp/avrone-operator-memory.json
#
# Export in-process lessons as a pasteable JSON blob for Vercel:
#   node --input-type=module -e "import { createRequire } from 'node:module'; /* or build */"
# Prefer calling exportLessonsForEnv() from lib/operator-memory (see README).
# Do NOT put API keys in AVRONE_OPERATOR_MEMORY — plain operator tips only.


# --- Optional LangSmith tracing (official LangChain env vars; no-op without key) ---
# Enable when you want LangGraph/LangChain runs in LangSmith. Requires an API key.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=avrone-chat
# Aliases also work: LANGSMITH_TRACING=true, LANGSMITH_API_KEY=, LANGSMITH_PROJECT=
# Leave unset / false in production unless Jean wants traces.

